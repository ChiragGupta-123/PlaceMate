# PlaceMate Environment Configuration
# Copy to .env and fill in values.

# Sandbox provider: "fake" (default, offline) or "judge0" (RapidAPI)
SANDBOX_PROVIDER=fake

# Judge0 CE on RapidAPI (required only when SANDBOX_PROVIDER=judge0)
JUDGE0_RAPIDAPI_KEY=
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
